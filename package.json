{
  "name": "ai-lead-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio site for Casper Tavitian",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "eval": "npm --prefix tools/agent-eval-harness run eval --",
    "test:harness": "npm --prefix tools/agent-eval-harness test",
    "postinstall": "npm --prefix tools/agent-eval-harness install --ignore-scripts",
    "eval:sample": "npm --prefix tools/agent-eval-harness run eval -- --suite suites/ops-triage.yaml --adapter mock"
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
